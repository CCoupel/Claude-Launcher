# Variables specifiques a PROD — voir agents/deploy.md section "Fichiers d'Environnement".
# Copier en prod.env (jamais commite) et completer les valeurs.
# Binaires du hub (MooseFS) : aucune variable requise.
# CL_ROOT_BASE=/share/MFS/ROOT/CLAUDE_PROJETS   # racine du dépôt des binaires (défaut si absente)

# Launcher du cluster (v6.3.0) — deploy.prod.md « Launcher du cluster »
PROD_NAMESPACE=claude-ng2
PROD_KUBECONFIG=PRIVATE/PROD/ng2-deploy.kubeconfig          # compte ng2-deploy de claude-ng2 (fiche administrateur)
PROD_VALUES_LOCAL=PRIVATE/PROD/values-local.yaml            # ingress.tls.clusterIssuer réel (jamais commité)
