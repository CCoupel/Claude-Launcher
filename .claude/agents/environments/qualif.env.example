# Variables specifiques a QUALIF — voir agents/deploy.md section "Fichiers d'Environnement".
# Copier en qualif.env (jamais commite) et completer les valeurs.
# Binaires de test (MooseFS) : aucune variable requise.
# CL_ROOT_BASE=/share/MFS/ROOT/CLAUDE_PROJETS   # racine du dépôt des binaires (défaut si absente)

# Launcher du cluster (v6.3.0) — deploy.qualif.md « Launcher du cluster »
QUALIF_REGISTRY=192.168.1.211:5000                          # registre interne (HTTP) de l'image candidate
QUALIF_NAMESPACE=claude-qualif
QUALIF_KUBECONFIG=PRIVATE/QUALIF/ng2-deploy.kubeconfig      # compte ng2-deploy de claude-qualif (fiche administrateur)
QUALIF_VALUES_LOCAL=PRIVATE/QUALIF/values-local.yaml        # ingress.tls.clusterIssuer réel (jamais commité)
