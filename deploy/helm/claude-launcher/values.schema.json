{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "claude-launcher — valeurs (contracts/helm-values.md)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rootBase",
    "volume"
  ],
  "properties": {
    "global": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$|^$"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$",
          "description": "empreinte de l'image (sha256:…), facultative"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "hubName": {
      "type": "string",
      "description": "CL_HUB_NAME : vide = nom de la release",
      "pattern": "^([a-zA-Z0-9][a-zA-Z0-9._-]{0,62})?$"
    },
    "rootBase": {
      "type": "string",
      "description": "OBLIGATOIRE : CL_ROOT_BASE, chemin absolu",
      "pattern": "^(/[^/]+)+$"
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingClaim"
      ],
      "properties": {
        "existingClaim": {
          "type": "string",
          "minLength": 1,
          "description": "OBLIGATOIRE : PVC RWX existant"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^((/[^/]+)+)?$"
        },
        "create": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "storage": {
              "type": "string",
              "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)$"
            },
            "storageClassName": {
              "type": "string"
            },
            "persistentVolume": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "name": {
                  "type": "string"
                },
                "source": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "runAsUser": {
      "type": "integer",
      "minimum": 1
    },
    "runAsGroup": {
      "type": "integer",
      "minimum": 1
    },
    "allowHostBackend": {
      "type": "boolean"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "type": {
          "const": "ClusterIP",
          "description": "seul ClusterIP est admis (NodePort et LoadBalancer refusés)"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "controller": {
          "type": "string"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "allowedSourceRanges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string"
            },
            "clusterIssuer": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "controller",
          "className",
          "host",
          "allowedSourceRanges",
          "tls"
        ],
        "properties": {
          "controller": {
            "enum": [
              "traefik",
              "nginx"
            ]
          },
          "className": {
            "type": "string",
            "minLength": 1
          },
          "host": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
          },
          "allowedSourceRanges": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}|[0-9a-fA-F:]+/[0-9]{1,3})$",
              "not": {
                "enum": [
                  "0.0.0.0/0",
                  "::/0"
                ]
              }
            }
          },
          "tls": {
            "anyOf": [
              {
                "required": [
                  "secretName"
                ],
                "properties": {
                  "secretName": {
                    "minLength": 1
                  }
                }
              },
              {
                "required": [
                  "clusterIssuer"
                ],
                "properties": {
                  "clusterIssuer": {
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 30
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "access": {
          "enum": [
            "none",
            "token"
          ],
          "description": "CL_WEB_ACCESS sans auth.enabled : none (défaut) ou token ; ne pas poser avec auth.enabled (imposé à proxy)"
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "legacy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "monte l'ancien PVC <release>-secrets (v6.4.0) en lecture seule s'il existe, pour la migration"
            }
          }
        },
        "persistence": {
          "type": "object",
          "description": "obsolète depuis 6.5.0 (ignoré) : accepté pour les fichiers de valeurs existants",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)$"
            },
            "storageClassName": {
              "type": "string"
            }
          }
        }
      }
    },
    "backends": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "docker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string"
            }
          }
        },
        "kubeconfigs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "secretName",
              "key"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 40
              },
              "secretName": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extraNamespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressNamespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ingressCIDRs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ingressPodSelector": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "externalIngress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clusterIssuer": {
              "type": "string"
            },
            "secretName": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "description": "v7.0.0 — accès authentifié (contracts/helm-values.md « Valeurs auth.* »)",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "clientId": {
              "type": "string",
              "description": "identifiant de la GitHub App (avec clientSecret ; exclusif avec auth.existingSecret)"
            },
            "clientSecret": {
              "type": "string",
              "description": "secret de la GitHub App : visible par helm get values — PRIVATE/<ENV>/values-local.yaml seulement"
            }
          }
        },
        "existingSecret": {
          "type": "string",
          "description": "Secret client-id / client-secret de la GitHub App"
        },
        "admins": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
          }
        },
        "users": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
          }
        },
        "localAdmin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string",
              "description": "Secret avec la clé htpasswd (admin@local:$2y$…)"
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "sessionDuration": {
          "type": "string",
          "pattern": "^[1-9][0-9]*[hm]$"
        },
        "sessionRefresh": {
          "type": "string",
          "pattern": "^[1-9][0-9]*[hm]$"
        },
        "proxy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": "string",
                  "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^(sha256:[0-9a-f]{64})?$"
                }
              }
            },
            "resources": {
              "type": "object"
            }
          }
        },
        "rateLimit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "average": {
              "type": "integer",
              "minimum": 1
            },
            "burst": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
